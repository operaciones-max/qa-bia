# Copiar a backend/.env para correr en local (backend/.env NO se versiona).
# Las variables ya definidas en el entorno tienen prioridad sobre este archivo.

# --- Obligatoria ---
ANTHROPIC_API_KEY=

# --- Opcionales: dejarlas vacias para NO escribir en produccion ---
# Con SUPABASE_URL vacio el QA analiza pero no guarda nada en Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Sin esta key se omite la factura anterior y la reconciliacion con App Ops.
METABASE_API_KEY=

# --- Modos de ejecucion (por defecto: los de produccion) ---
QA_MODO_PRUEBA=true
QA_ACTAS_PRUEBA=2
# Estado aparte para no tocar backend/state/ (que es el de produccion).
QA_STATE_DIR=backend/state-local
# QA_FECHA_INICIO=2026-05-10
# QA_MAX_ACTAS_POR_RUN=30
# QA_PAUSA_ENTRE_ACTAS_SEGUNDOS=20
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# En VIPE e INST, leer con OCR las fotos de los equipos (una llamada mas a Claude por acta).
# QA_OCR_FOTOS=true

# --- Servicio de extraccion (go run ./backend/cmd/extraccion) ---
# Ver docs/servicio-extraccion.md. Usa ANTHROPIC_API_KEY y Supabase de arriba.
# EXTRACCION_MODELO=claude-opus-5-5
# EXTRACCION_ESFUERZO=
# En produccion definir una API key que deben mandar quienes lo llaman.
# EXTRACCION_API_KEY=
# EXTRACCION_PUERTO=8081
