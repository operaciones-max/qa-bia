# Copiar a frontend/.env para correr en local (no se versiona).
# URL base del proyecto de Supabase y la ANON key. Nunca la service role key:
# el dashboard actua con el usuario logueado y lo protegen las politicas RLS.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=

# Puerto del servidor (por defecto 8080)
PUERTO=8080

# true cuando se sirve por HTTPS (marca la cookie de sesion como Secure)
COOKIE_SEGURA=false
